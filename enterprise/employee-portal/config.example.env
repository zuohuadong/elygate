# 员工门户公开地址。反向代理挂载在 /employee/ 时必须保留该路径。
EMPLOYEE_PORTAL_PUBLIC_URL=https://elygate.example.com/employee
EMPLOYEE_PORTAL_PORT=8090
EMPLOYEE_PORTAL_SESSION_SECRET=replace-with-at-least-32-random-characters

# Elygate/Bifrost 管理面。管理令牌只保存在服务端，绝不能下发到浏览器。
BIFROST_MANAGEMENT_URL=http://elygate:8080
BIFROST_MANAGEMENT_TOKEN=env-or-secret-manager-value

# zuohuadong/supauth：支持 OIDC discovery；若 SupAuth 未发布 discovery，可显式填写三个端点。
SUPAUTH_ISSUER=https://auth.example.com
SUPAUTH_CLIENT_ID=elygate-employee-portal
# SupAuth/GoTrue 推荐 public client + PKCE，默认不配置 client secret。
# SUPAUTH_CLIENT_SECRET=only-when-the-registered-client-is-confidential
SUPAUTH_PROJECT_REF=your-supacloud-project-ref
# SUPAUTH_AUTHORIZATION_URL=https://auth.example.com/oauth/authorize
# SUPAUTH_TOKEN_URL=https://auth.example.com/oauth/token
# SUPAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json

# 可选的第二个企业 SSO。支持任意标准 OIDC 身份提供商。
ENTERPRISE_SSO_ISSUER=https://sso.example.com
ENTERPRISE_SSO_CLIENT_ID=elygate-employee-portal
# 若企业 IdP 注册的是 confidential client，再配置下面的 secret。
# ENTERPRISE_SSO_CLIENT_SECRET=env-or-secret-manager-value
# ENTERPRISE_SSO_AUTHORIZATION_URL=
# ENTERPRISE_SSO_TOKEN_URL=
# ENTERPRISE_SSO_JWKS_URL=

# 默认只有带 employee 角色的已验证身份可进入；多个角色用逗号分隔。
EMPLOYEE_PORTAL_ALLOWED_ROLES=employee

# 可选：覆盖用户 ID 映射。邮箱固定使用标准 OIDC email 声明。
EMPLOYEE_PORTAL_USER_ID_CLAIM=sub
# 默认要求 OIDC email_verified=true；只有 IdP 无法提供该声明且已有等价校验时才能显式关闭。
EMPLOYEE_PORTAL_REQUIRE_VERIFIED_EMAIL=true
