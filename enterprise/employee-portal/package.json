{
  "name": "@elygate/employee-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "bun run build:web && bun build src/index.ts --target=bun --outdir=dist/server",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/svelte-check --tsconfig web/tsconfig.json",
    "test": "bun test",
    "start": "bun dist/server/index.js"
  },
  "dependencies": {
    "elysia": "1.4.29",
    "jose": "6.2.8"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/bun": "latest",
    "svelte": "5.56.9",
    "svelte-check": "latest",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
