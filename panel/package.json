{
  "name": "@elygate/panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build && bun run check && bun run copy-build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src/lib/*.test.ts && bun test tests/*.test.ts",
    "test:relay-runtime": "bun test tests/runtime/relay.test.ts",
    "copy-build": "rm -rf ../transports/bifrost-http/ui && cp -R out ../transports/bifrost-http/ui"
  },
  "dependencies": {
    "@lucide/svelte": "1.37.0",
    "@svadmin/core": "0.66.2",
    "@svadmin/ui": "0.96.1",
    "@tanstack/svelte-query": "^6.3.5",
    "highlight.js": "^11.12.0",
    "isomorphic-dompurify": "^3.23.0",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/papaparse": "5.5.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "patchedDependencies": {
    "@svadmin/ui@0.96.1": "patches/@svadmin%2Fui@0.96.1.patch"
  }
}
