{
  "name": "@elygate/panel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build && bun run check && bun run copy-build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "bun test src/lib/*.test.ts",
    "copy-build": "rm -rf ../transports/bifrost-http/ui && cp -R out ../transports/bifrost-http/ui"
  },
  "dependencies": {
    "@svadmin/core": "0.41.0",
    "@svadmin/ui": "0.53.1",
    "@tanstack/svelte-query": "^6.1.38",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^3.22.0",
    "marked": "^18.0.9",
    "marked-highlight": "^2.2.4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "patchedDependencies": {
    "@svadmin/ui@0.53.1": "patches/@svadmin%2Fui@0.53.1.patch"
  }
}
